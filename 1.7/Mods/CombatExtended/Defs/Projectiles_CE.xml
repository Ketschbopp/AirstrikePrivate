<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <!-- Only loaded with Combat Extended (see LoadFolders.xml).

         CE version of the strafing missile: a CE projectile (CE armour, height and
         collision model) with a shaped-charge penetrator, a small HE burst and a smoke
         trail via CE's TrailerProjectileExtension. Modelled on CE's guided rockets
         (e.g. the 90mm MATADOR). -->
    <ThingDef ParentName="BaseBulletCE">
        <defName>ROCKET_Bullet_StrafingMissile_CE</defName>
        <label>air-to-ground missile</label>
        <description>Shaped-charge air-to-ground missiles. The penetrator punches through heavy vehicle armour; the warhead's small blast covers the 3x3 cells around the impact.</description>
        <graphicData>
            <texPath>Things/Projectile/ROCKET_Missile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>1.3</drawSize>
        </graphicData>
        <projectile Class="CombatExtended.ProjectilePropertiesCE">
            <damageDef>Bullet</damageDef>
            <damageAmountBase>200</damageAmountBase>
            <armorPenetrationSharp>450</armorPenetrationSharp>
            <armorPenetrationBlunt>40</armorPenetrationBlunt>
            <speed>60</speed>
            <soundAmbient>RocketPropelledLoop_Small</soundAmbient>
        </projectile>
        <comps>
            <li Class="CombatExtended.CompProperties_ExplosiveCE">
                <damageAmountBase>90</damageAmountBase>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <explosiveRadius>1.9</explosiveRadius>
                <explosionSound>MortarBomb_Explode</explosionSound>
            </li>
            <li Class="CombatExtended.CompProperties_Fragments">
                <fragments>
                    <Fragment_Small>6</Fragment_Small>
                </fragments>
            </li>
        </comps>
        <modExtensions>
            <li Class="ProjectileImpactFX.TrailerProjectileExtension">
                <trailMoteSize>0.7</trailMoteSize>
                <trailerMoteInterval>1</trailerMoteInterval>
                <motesThrown>1</motesThrown>
            </li>
        </modExtensions>
    </ThingDef>
</Defs>
