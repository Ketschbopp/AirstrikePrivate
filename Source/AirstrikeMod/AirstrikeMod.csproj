<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- RimWorld 1.7 runs on .NET 10 (Waylith); mods target net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AirstrikeMod</AssemblyName>
    <RootNamespace>AirstrikeMod</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\Assemblies</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Adjust this path if your install isn't at the default Steam location.
    VehicleFrameworkDir points at the workshop folder for "Vehicle Framework" (3014915404).
  -->
  <PropertyGroup>
    <VehicleFrameworkDir>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3014915404</VehicleFrameworkDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- RimWorld 1.7 reference assemblies (Assembly-CSharp, UnityStubs, Waylith...). No game install needed. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.2" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Vehicle Framework. Workshop layout ships its 1.7 DLLs under <workshop>/1.7/Assemblies.
      If you're working from a development checkout instead, point VehicleFrameworkDir there
      and these HintPaths will resolve the same way.
    -->
    <Reference Include="Vehicles">
      <HintPath>$(VehicleFrameworkDir)\1.7\Assemblies\Vehicles.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VehicleFrameworkDir)\1.7\Assemblies\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CoreLib">
      <HintPath>$(VehicleFrameworkDir)\1.7\Assemblies\CoreLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\1.7\**\*.xml" Link="ModXML\1.7\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\Languages\**\*.xml" Link="ModXML\Languages\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\Patches\**\*.xml" Link="ModXML\Patches\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\..\About\*.xml" Link="ModXML\About\%(Filename)%(Extension)" />
    <None Include="..\..\LoadFolders.xml" Link="ModXML\LoadFolders.xml" />
  </ItemGroup>
</Project>
